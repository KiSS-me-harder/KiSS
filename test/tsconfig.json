{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "~": ["../app"],
      "~/*": ["../app/*"],
      "@": ["../app"],
      "@/*": ["../app/*"]
    }
  },
  "include": ["**/*.ts"]
}
