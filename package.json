{
  "name": "projects",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "nuxt generate",
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "prepare": "husky",
    "test": "pnpm test:e2e",
    "test:e2e": "NODE_ENV=test node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber-js",
    "test:e2e:single": "pnpm test:e2e --profile single",
    "test:e2e:rerun": "pnpm test:e2e --profile rerun"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sqlite3"
    ],
    "overrides": {
      "@cucumber/cucumber": "13.2.1"
    }
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.142",
    "@iconify-json/simple-icons": "^1.2.99",
    "@internationalized/date": "^3.12.4",
    "@nuxt/content": "3.16.1",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/seo": "^5.3.16",
    "@pinia/nuxt": "^1.0.2",
    "@tanstack/table-core": "^9.2.8",
    "@unhead/vue": "^3.4.2",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vite-pwa/nuxt": "1.1.1",
    "@vue/devtools-api": "^8.2.1",
