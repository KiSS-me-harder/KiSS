{
  "name": "projects",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "nuxt generate",
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "prepare": "husky",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "start-server-and-test dev http://localhost:3000 test:e2e:cucumber",
    "test:e2e:cucumber": "cucumber-js --config cucumber.config.ts",
    "test:e2e:pages": "cucumber-js --profile pages",
    "test:e2e:components": "cucumber-js --profile components",
    "test:e2e:pages:server": "start-server-and-test dev http://localhost:3000 test:e2e:pages",
    "test:e2e:components:server": "start-server-and-test dev http://localhost:3000 test:e2e:components",
    "test:e2e:playwright": "playwright test --config playwright.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "sqlite3"
    ]
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.142",
    "@iconify-json/simple-icons": "^1.2.99",
    "@internationalized/date": "^3.12.4",
    "@nuxt/content": "3.16.1",
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/test-utils": "4.3.3",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/seo": "^5.3.16",
    "@pinia/nuxt": "^1.0.2",
    "@tanstack/table-core": "^9.2.8",
    "@unhead/vue": "^3.4.2",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "nuxt": "^4.6.1",
    "pinia": "^4.0.3",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/messages": "^34.2.1",
    "@cucumber/pretty-formatter": "^4.1.0",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "start-server-and-test": "^3.0.13",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13"
  }
}
