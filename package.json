    "@vueuse/nuxt": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "nuxt": "^4.6.2",
    "pinia": "^4.0.3",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@cucumber/messages": "^34.2.1",
    "@cucumber/pretty-formatter": "^4.1.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.2",
